# ---- Deployment mode ----
# demo  : in-memory knowledge base from /content, mock AI providers, no database needed
# full  : Supabase + configured providers
GHANAVOICE_MODE=demo

# ---- Supabase (required in full mode) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Provider selection (all replaceable; see docs/05-provider-adapters.md) ----
# stt: mock | http | openai
STT_PROVIDER=mock
# tts: mock | http | browser  (browser = client-side Web Speech API, no server cost)
TTS_PROVIDER=browser
# llm: extractive | anthropic | openai-compatible
LLM_PROVIDER=extractive
# embeddings: hash-local | openai | http
EMBEDDING_PROVIDER=hash-local

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_STT_MODEL=whisper-1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Generic HTTP adapters (e.g. a self-hosted Ghanaian-language ASR endpoint)
STT_HTTP_URL=
STT_HTTP_TOKEN=
TTS_HTTP_URL=
TTS_HTTP_TOKEN=
EMBEDDING_HTTP_URL=
EMBEDDING_HTTP_TOKEN=

# ---- Privacy ----
# Days after which stored audio is deleted automatically (users may choose shorter)
AUDIO_RETENTION_DAYS_MAX=30
# Salt for hashing anonymous session identifiers in analytics
ANALYTICS_SALT=change-me

# ---- Admin ----
# Comma-separated e-mail addresses allowed into /admin in demo mode
ADMIN_EMAILS=
# Shared secret for demo-mode admin API calls (header: x-admin-token)
ADMIN_TOKEN=change-me
