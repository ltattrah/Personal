# Copy to .env and adjust. Every setting has a working default for local development.

# SQLite by default; for the Phase 2 stack use PostGIS/TimescaleDB, e.g.
# DATABASE_URL=postgresql+psycopg://transit:transit@localhost:5432/transit
DATABASE_URL=sqlite:///./kumasi_transit.db

# MQTT broker used by the tracking ingest and the fleet simulator.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=kumasi/fleet/+/+/pos

# Loading-status reports older than this are treated as stale (seconds).
LOADING_REPORT_TTL_SECONDS=1200

# Where the built GTFS zip and fare tables are written.
BUILD_DIR=./build

# Shared secret trackers/gateways send in the X-Tracker-Key header when posting positions over HTTP.
TRACKER_API_KEY=change-me
